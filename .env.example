# Optional. Required only for analyze / twin commands.
GEMINI_API_KEY=

# Public Gemini model id. Override if your key has a different catalog.
GEMINI_MODEL=gemini-2.0-flash

# Root where clone jobs land. Relative paths resolve from cwd.
GEMINI_CLONE_ROOT=clones

# Hard caps for public web snapshots. Raise only for sources you own.
GEMINI_WEB_MAX_PAGES=40
GEMINI_WEB_MAX_BYTES=8000000
GEMINI_WEB_TIMEOUT=20

# Never put private tokens, cookies, session dumps, or login passwords here.
